# n8n Production Environment - OIDC Full Mode
# Updated: 2026-06-10 - Fixed domain/HTTPS for external access

N8N_BASIC_AUTH_ACTIVE=***
N8N_SECURE_COOKIE=false
N8N_PROTOCOL=https
N8N_HOST=n8n.home.martini.wang
N8N_PORT=5680

# OIDC Configuration (Keycloak martini realm)
N8N_SSO_OIDC_LOGIN_ENABLED=true
N8N_SSO_OIDC_ISSUER_URL=https://auth.home.martini.wang:50443/realms/martini
N8N_SSO_OIDC_CLIENT_ID=n8n-prod
N8N_SSO_OIDC_CLIENT_SECRET=n8n-pr...2026
N8N_SSO_OIDC_REDIRECT_URI=https://n8n.home.martini.wang:50443/rest/login/oidc/callback
N8N_SSO_OIDC_SCOPE="openid profile email"
N8N_SSO_OIDC_AUTO_PROVISION=true
N8N_SSO_REDIRECT_LOGIN_TO_SSO=true
N8N_SSO_JUST_IN_TIME_PROVISIONING=true

# Database
DB_TYPE=sqlite
DB_SQLITE_DATABASE=/app/n8n-test-data/database-prod.sqlite

EXECUTIONS_MODE=regular
NO_PROXY=127.0.0.1,localhost,auth.home.martini.wang
